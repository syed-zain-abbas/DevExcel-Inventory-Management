@model Inventory.Application.DTOs.ProductDetailsDto
@using Inventory.Domain.Enums

@{
    ViewData["Title"] = "Product Details";
    var product = Model.Product;
}

<div class="d-flex justify-content-between
    align-items-center mb-4">

    <div>
        <h2>@product.Name</h2>
        <p class="text-muted">SKU: @product.Sku</p>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="Edit"
           asp-route-id="@product.Id"
           class="btn btn-outline-primary">
            Edit Product
        </a>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Products
        </a>

    </div>

</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">
        @success
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Current Stock</h6>
                <h2>@product.CurrentStock</h2>

                @if (product.IsLowStock)
                {
                    <span class="badge bg-warning text-dark">
                        Low Stock
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        In Stock
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Reorder Level</h6>
                <h2>@product.ReorderLevel</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted">Product Status</h6>

                @if (product.IsActive)
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactive
                    </span>
                }
            </div>
        </div>
    </div>

</div>

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <h5 class="mb-0">Product Information</h5>
    </div>

    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">SKU</dt>
            <dd class="col-sm-9">@product.Sku</dd>

            <dt class="col-sm-3">Product Name</dt>
            <dd class="col-sm-9">@product.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(product.Description)
                    ? "Not provided"
                    : product.Description)
            </dd>

            <dt class="col-sm-3">Created Date</dt>
            <dd class="col-sm-9">
                @product.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC
            </dd>

        </dl>

    </div>

</div>

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <h5 class="mb-0">Record Stock Movement</h5>
    </div>

    <div class="card-body">

        @if (product.IsActive)
        {
            <form asp-controller="StockMovements"
                  asp-action="Create"
                  method="post">

                <input type="hidden"
                       name="ProductId"
                       value="@product.Id" />

                <div class="row g-3">

                    <div class="col-md-4">

                        <label for="Type" class="form-label">
                            Movement Type
                        </label>

                        <select id="Type"
                                name="Type"
                                class="form-select"
                                required>

                            <option value="">Select Type</option>

                            <option value="@((int)MovementType.In)">
                                Stock In
                            </option>

                            <option value="@((int)MovementType.Out)">
                                Stock Out
                            </option>

                        </select>

                    </div>

                    <div class="col-md-4">

                        <label for="Quantity" class="form-label">
                            Quantity
                        </label>

                        <input type="number"
                               id="Quantity"
                               name="Quantity"
                               class="form-control"
                               min="1"
                               max="@int.MaxValue"
                               step="1"
                               required />

                    </div>

                    <div class="col-md-4">

                        <label for="Note" class="form-label">
                            Note (Optional)
                        </label>

                        <input type="text"
                               id="Note"
                               name="Note"
                               maxlength="500"
                               class="form-control"
                               placeholder="Movement reason" />

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary mt-3">
                    Record Movement
                </button>

            </form>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                This product is inactive.
                Stock movements are not allowed.
            </div>
        }

    </div>

</div>

<div class="card shadow-sm">

    <div class="card-header">
        <h5 class="mb-0">Stock Movement History</h5>
    </div>

    <div class="table-responsive">

        <table class="table table-hover
            align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th>Date (UTC)</th>
                    <th>Movement Type</th>
                    <th>Quantity</th>
                    <th>Note</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Movements.Count == 0)
                {
                    <tr>
                        <td colspan="4"
                            class="text-center text-muted py-4">
                            No stock movements recorded.
                        </td>
                    </tr>
                }

                @foreach (var movement in Model.Movements)
                {
                    <tr>

                        <td>
                            @movement.CreatedUtc.ToString(
                                "dd MMM yyyy HH:mm")
                        </td>

                        <td>
                            @if (movement.Type == MovementType.In)
                            {
                                <span class="badge bg-success">
                                    Stock In
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Stock Out
                                </span>
                            }
                        </td>

                        <td>
                            @if (movement.Type == MovementType.In)
                            {
                                <span class="text-success">
                                    +@movement.Quantity
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">
                                    -@movement.Quantity
                                </span>
                            }
                        </td>

                        <td>
                            @(movement.Note ?? "-")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>